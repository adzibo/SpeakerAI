{
  "__comment__": [
    "Plantilla de configuración para fine-tuning del GPT encoder de XTTS v2.",
    "trainer.py sustituye los campos {{PLACEHOLDER}} en tiempo de ejecución.",
    "Optimizada para NVIDIA RTX 4080 SUPER (16 GB VRAM) con CUDA 12.x.",
    "Solo se entrena el GPT encoder; el decoder y el DVAE se reutilizan del base."
  ],

  "model": "xtts",

  "run_name": "{{RUN_NAME}}",
  "run_description": "SpeakerTTS fine-tuning — voz: {{VOICE_NAME}}",

  "output_path": "{{OUTPUT_PATH}}",

  "model_dir": "{{BASE_MODEL_DIR}}",

  "languages": ["{{LANGUAGE}}"],

  "audio": {
    "sample_rate": 22050,
    "output_sample_rate": 24000
  },

  "model_args": {
    "kv_cache": true,
    "gpt_use_perceiver_resampler": true,
    "gpt_use_masking_gt_prompt_approach": true
  },

  "datasets": [
    {
      "formatter": "coqui",
      "dataset_name": "{{DATASET_NAME}}",
      "path": "{{DATASET_PATH}}",
      "meta_file_train": "metadata.csv",
      "meta_file_val": null,
      "language": "{{LANGUAGE}}",
      "phonemizer": null,
      "phoneme_cache_path": null
    }
  ],

  "batch_size": 8,
  "eval_batch_size": 4,

  "num_loader_workers": 8,
  "num_eval_loader_workers": 4,

  "mixed_precision": true,
  "precision": "fp16",

  "epochs": 10,
  "save_step": 500,
  "save_n_checkpoints": 3,
  "save_checkpoints": true,
  "save_all_best": true,
  "save_best_after": 200,

  "print_step": 50,
  "plot_step": 100,
  "log_model_step": 500,

  "eval_split_size": 0.01,
  "eval_split_max_size": 256,

  "run_eval": true,
  "run_eval_steps": 500,

  "dashboard_logger": "tensorboard",

  "optimizer": "AdamW",
  "optimizer_params": {
    "betas": [0.9, 0.96],
    "eps": 1e-8,
    "weight_decay": 1e-2
  },

  "lr": 5e-6,
  "lr_scheduler": "MultiStepLR",
  "lr_scheduler_params": {
    "milestones": [50000, 150000, 300000],
    "gamma": 0.5,
    "last_epoch": -1
  },
  "scheduler_after_epoch": false,

  "cudnn_enable": true,
  "cudnn_benchmark": false,
  "cudnn_deterministic": false,
  "training_seed": 54321,

  "min_audio_len": 22050,
  "max_audio_len": 331776,

  "min_text_len": 1,
  "max_text_len": 500,

  "gpt_cond_len": 12,
  "gpt_cond_chunk_len": 4,
  "max_ref_len": 10,
  "sound_norm_refs": false,

  "temperature": 0.75,
  "length_penalty": 1.0,
  "repetition_penalty": 5.0,
  "top_k": 50,
  "top_p": 0.85,
  "num_gpt_outputs": 1
}
